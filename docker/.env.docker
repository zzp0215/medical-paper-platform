# ============================================
# Docker Compose 环境变量 (本文件)
# ============================================
# 主项目环境变量在根目录的 .env (从 .env.example 复制)
# 本文件仅控制 docker-compose.yml 的服务端口 / 凭据
# 警告: .env.docker 包含 dev 凭据,生产环境务必修改后用 .gitignore 排除
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=medpaper
POSTGRES_PASSWORD=medpaper_dev_pwd
POSTGRES_DB=medpaper
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=redis_dev_pwd
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=medpaper
MINIO_ROOT_PASSWORD=minio_dev_pwd
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Milvus ----------
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# ---------- Elasticsearch ----------
ES_PASSWORD=es_dev_pwd
ES_PORT=9200

# ---------- 管理工具 (--profile admin) ----------
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_INSIGHT_PORT=8001
KIBANA_PASSWORD=kibana_dev_pwd
KIBANA_PORT=5601

# ---------- LiteLLM (Phase 1.1.5) ----------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-master-dev-key-change-in-prod
LITELLM_SALT_KEY=sk-litellm-salt-dev-key-change-in-prod
# 透传给 litellm/.env (可选, 覆盖默认值)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MiniMax_API_KEY=sk-ant-your-anthropic-key
MiniMax_BASE_URL=https://api.MiniMax.com
VLM_API_KEY=sk-your-vlm-key
VLM_API_BASE=https://api.openai.com/v1
