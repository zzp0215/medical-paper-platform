# ============================================
# LiteLLM 自身的环境变量 (容器内由 docker-compose 注入)
# ============================================
# 用法: cp .env.example .env, 填真实密钥
# 主密钥用于访问 /chat/completions (Bearer)
# 业务密钥透传给上游
# ============================================

# ---------- 主密钥 (访问 /chat/completions 的 Bearer) ----------
LITELLM_MASTER_KEY=sk-litellm-master-change-me
LITELLM_SALT_KEY=sk-litellm-salt-change-me

# ---------- 业务密钥 (透传给上游) ----------
# DeepSeek-V3 主力
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MiniMax (Claude 兼容)
MiniMax_API_KEY=sk-ant-your-anthropic-key
MiniMax_BASE_URL=https://api.MiniMax.com
# OpenAI 嵌入 (text-embedding-3-small)
VLM_API_KEY=sk-your-openai-key
VLM_API_BASE=https://api.openai.com/v1

# ---------- Redis (缓存 + 限流) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pwd

# ---------- Postgres (usage 日志) ----------
LITELLM_DATABASE_URL=postgresql://medpaper:medpaper_dev_pwd@postgres:5432/medpaper_litellm
