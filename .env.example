# ============================================
# 医学论文自动生成平台 - 环境变量模板
# ============================================
# 用法:  cp .env.example .env  然后填入真实值
# 警告:  .env 文件已被 .gitignore 排除,切勿提交真实密钥
# ============================================

# ---------- 应用 ----------
APP_NAME=medical-paper-platform
APP_ENV=development               # development | staging | production
DEBUG=true
SECRET_KEY=change-me-please-use-openssl-rand-hex-32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 后端服务 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- 路径 ----------
DATA_DIR=./data
CHROMA_DB_DIR=./chroma_db
LOGS_DIR=./logs
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/tmp

# ============================================
# LLM 网关 (LiteLLM 统一调度) - 简化版 v0
# ============================================
# 决策 2026-06-04: 暂只用云端 API (DeepSeek + MiniMax), 不上本地模型
# 后续 Phase 8 评估效果再决定是否引入 MMed-Llama3 / BGE-Reranker

# DeepSeek-V3 主力 (论文写作/Planner/Verifier/翻译)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# MiniMax 备用 (Claude 4.6 兼容, 质量敏感场景)
MiniMax_API_KEY=sk-ant-your-anthropic-key
MiniMax_BASE_URL=https://api.MiniMax.com
MiniMax_MODEL=MiniMax-sonnet-4-6

# OpenAI 嵌入 (text-embedding-3-small, 1536 维)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=8

# LiteLLM Proxy 自身 (统一入口, 4000 端口)
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-litellm-change-me

# ============================================
# 检索参数
# ============================================
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8

# 旧字段保留 (本地模型接口, 暂未启用)
# MMed-Llama3-8B 医学翻译 (Phase 8 评估后再启用)
# MMED_LLAMA_ENABLED=false
# MMED_LLAMA_API_BASE=http://localhost:8001/v1
# MMED_LLAMA_MODEL=mmed-llama-3-8b
#
# 本地 BGE-M3 / Reranker (Phase 3 评估后再启用)
# USE_LOCAL_EMBEDDING=false
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_RERANKER_MODEL=BAAI/bge-reranker-large

# ============================================
# 关系数据库 (PostgreSQL)
# ============================================
POSTGRES_USER=medpaper
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=medpaper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://medpaper:change-me-in-prod@postgres:5432/medpaper
DATABASE_URL_SYNC=postgresql+psycopg2://medpaper:change-me-in-prod@postgres:5432/medpaper

# ============================================
# 缓存 + 消息队列 (Redis + Celery)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# 对象存储 (MinIO)
# ============================================
MINIO_ROOT_USER=medpaper
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_ENDPOINT=minio:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_BUCKET_PDFS=medpaper-pdfs
MINIO_BUCKET_FIGURES=medpaper-figures
MINIO_SECURE=false

# ============================================
# 向量数据库 (Milvus)
# ============================================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus
MILVUS_DB_NAME=medpaper

# ============================================
# 全文检索 (Elasticsearch)
# ============================================
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http
ES_USER=elastic
ES_PASSWORD=change-me-in-prod

# ============================================
# RAGFlow 知识库 (Phase 3)
# ============================================
RAGFLOW_ENABLED=false
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_BASE_URL=http://ragflow:9380/api/v1
RAGFLOW_KNOWLEDGE_BASE_ID=

# ============================================
# PDF 解析 (Phase 2 - MinerU)
# ============================================
MINERU_ENABLED=false
MINERU_API_BASE=http://mineru-service:8000
MINERU_PARSE_METHOD=auto              # auto | txt | ocr
MINERU_LANG=ch                         # ch | en | korean | japan
MINERU_DEVICE=cpu                      # cpu | cuda

# ============================================
# LangGraph 多 Agent (Phase 4)
# ============================================
LANGGRAPH_CHECKPOINT_DIR=./langgraph_checkpoints
LANGGRAPH_MAX_ITERATIONS=5             # 自反馈循环上限
LANGGRAPH_ENABLE_HUMAN_LOOP=true
WRITER_PARALLEL_WORKERS=4              # 多章节并行数

# ============================================
# Word 输出 (Phase 6)
# ============================================
WORD_TEMPLATE_PATH=./templates/ama_template.docx
WORD_OUTPUT_DIR=./data/outputs

# ============================================
# 监控 / 限流 / 日志
# ============================================
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
RATE_LIMIT_PER_MINUTE=60

# ============================================
# LLM 路由策略 (Phase 4)
# ============================================
LLM_ROUTER_STRATEGY=cost_first         # cost_first | quality_first | manual
LLM_DEFAULT_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
